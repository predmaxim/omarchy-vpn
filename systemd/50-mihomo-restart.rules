// /etc/polkit-1/rules.d/50-mihomo-restart.rules
// The widget applies a new config by restarting mihomo: let a local, active
// user restart their own mihomo@<user> unit without a password — nothing else.
polkit.addRule(function(action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "mihomo@" + subject.user + ".service" &&
      action.lookup("verb") == "restart" && subject.local && subject.active)
    return polkit.Result.YES
})
