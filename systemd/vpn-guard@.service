# /etc/systemd/system/vpn-guard@.service
# predmaxim.vpn: networks in ~/.config/mihomo/vpn-addresses.txt of %i are reached
# only through mihomo's TUN, held by nftables; names in vpn-domains.txt are resolved
# only through it (systemd-resolved's global DNS, held the same way). Up before the
# network, after resolved (it reloads it); the widget reloads it after a change.
[Unit]
Description=Always through VPN for %i: addresses and DNS (predmaxim.vpn)
After=systemd-resolved.service
Before=network-pre.target
Wants=network-pre.target
RequiresMountsFor=/home/%i

[Service]
Type=oneshot
RemainAfterExit=yes
# oneshot has no start timeout by default, and the network waits for this unit;
# it also bounds reloads (man systemd.service)
TimeoutStartSec=30s
ExecStart=/usr/local/lib/omarchy-vpn/vpn-guard start %i
ExecReload=/usr/local/lib/omarchy-vpn/vpn-guard start %i
# Post, not ExecStop=: it also runs after a failed or timed-out start (man systemd.service)
ExecStopPost=/usr/local/lib/omarchy-vpn/vpn-guard stop

[Install]
WantedBy=multi-user.target
